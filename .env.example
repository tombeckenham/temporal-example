# xAI (worker process only — never ship to the browser)
XAI_API_KEY=xai-...
# Optional override for e2e / AIMock (CopilotKit):
# XAI_BASE_URL=http://127.0.0.1:4010/v1
# XAI_API_KEY=mock

# Existing Drizzle scaffold (unused by video flow)
DATABASE_URL=dev.db

# Temporal (local CLI/docker or Temporal Cloud)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Temporal Cloud (pick one auth style):
# TEMPORAL_API_KEY=
# TEMPORAL_TLS_CERT_PATH=./certs/client.pem
# TEMPORAL_TLS_KEY_PATH=./certs/client.key

# Edge → Node Temporal gateway (required for startVideoWorkflow)
TEMPORAL_STARTER_SECRET=change-me
TEMPORAL_STARTER_URL=http://127.0.0.1:8788
TEMPORAL_GATEWAY_PORT=8788
# TEMPORAL_GATEWAY_DISABLED=1

# Node worker → Cloudflare JobRoom status push
STATUS_WEBHOOK_URL=http://127.0.0.1:3000
STATUS_WEBHOOK_SECRET=change-me
