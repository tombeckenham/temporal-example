# xAI (Node worker only)
XAI_API_KEY=xai-...
# Optional AIMock override for e2e:
# XAI_BASE_URL=http://127.0.0.1:4010/v1
# XAI_API_KEY=mock

# PlanetScale Postgres (pooled URL preferred, port 6432)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6432/postgres?sslmode=require

# Better Auth
BETTER_AUTH_SECRET= # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000

# Email OTP — console logs codes locally; use CF Email binding in production
EMAIL_MODE=console
EMAIL_FROM=noreply@yourdomain.com

# Temporal (local CLI/docker or Temporal Cloud)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# TEMPORAL_API_KEY=
# TEMPORAL_TLS_CERT_PATH=
# TEMPORAL_TLS_KEY_PATH=

# Edge ↔ Node Temporal gateway
TEMPORAL_STARTER_SECRET=change-me
TEMPORAL_STARTER_URL=http://127.0.0.1:8788
TEMPORAL_GATEWAY_PORT=8788

# Node worker → edge (JobRoom + R2)
STATUS_WEBHOOK_URL=http://127.0.0.1:3000
STATUS_WEBHOOK_SECRET=change-me
