{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "video-at-scale",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": {
    "enabled": true,
  },
  // Reconcile video_job rows stuck at 'running' (see src/lib/jobReconcile.ts)
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "JOB_ROOM",
        "class_name": "JobRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["JobRoom"],
    },
  ],
  "r2_buckets": [
    {
      "binding": "VIDEOS",
      "bucket_name": "video-at-scale-videos",
      "preview_bucket_name": "video-at-scale-videos-preview",
    },
  ],
  // Cloudflare Email Service (onboard a domain first). Use remote:true for real send in wrangler dev.
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  // Optional Hyperdrive (create with: wrangler hyperdrive create …)
  // Uncomment after creating a config; edge will prefer HYPERDRIVE over DATABASE_URL.
  // "hyperdrive": [
  //   {
  //     "binding": "HYPERDRIVE",
  //     "id": "<hyperdrive-config-id>",
  //   },
  // ],
  // Secrets (wrangler secret put):
  //   DATABASE_URL (if not using Hyperdrive), BETTER_AUTH_SECRET, BETTER_AUTH_URL,
  //   STATUS_WEBHOOK_SECRET, TEMPORAL_STARTER_URL, TEMPORAL_STARTER_SECRET,
  //   EMAIL_FROM, EMAIL_MODE
  "vars": {
    "APP_NAME": "video-at-scale",
    "EMAIL_MODE": "console",
  },
}
