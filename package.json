{
  "name": "video-at-scale",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:all": "bun run --parallel temporal:dev worker dev",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "secrets:sync-edge": "bun scripts/sync-secrets.ts edge",
    "secrets:sync-fly": "bun scripts/sync-secrets.ts fly",
    "secrets:sync": "bun scripts/sync-secrets.ts all",
    "cf-typegen": "wrangler types",
    "lint": "oxlint .",
    "format": "oxfmt . && oxlint --fix .",
    "check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "lefthook install",
    "test:e2e": "bun run e2e/run.ts",
    "test:e2e:ui": "bun run e2e/run.ts -- --ui",
    "test:e2e:ps": "E2E_DB_BACKEND=planetscale bun run e2e/run.ts",
    "worker": "tsx --env-file=.env.local src/temporal/worker.ts",
    "temporal:dev": "mkdir -p .temporal && temporal server start-dev --db-filename .temporal/dev.db --ui-port 8233",
    "temporal:docker": "docker compose up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.26",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/ai": "^0.43.1",
    "@tanstack/ai-grok": "^0.14.10",
    "@tanstack/ai-persistence": "^0.1.1",
    "@tanstack/ai-react": "^0.19.1",
    "@tanstack/react-devtools": "^0.10.9",
    "@tanstack/react-router": "^1.170.25",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-start": "^1.168.42",
    "@temporalio/activity": "^1.22.0",
    "@temporalio/client": "^1.22.0",
    "@temporalio/common": "^1.22.0",
    "@temporalio/worker": "^1.22.0",
    "@temporalio/workflow": "^1.22.0",
    "better-auth": "^1.6.26",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "nitro": "3.0.260610-beta",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@cloudflare/workers-types": "^5.20260809.1",
    "@copilotkit/aimock": "^1.38.0",
    "@playwright/test": "^1.62.1",
    "@tanstack/devtools-vite": "^0.8.3",
    "@tanstack/router-cli": "^1.167.27",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.4.2",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wrangler": "^4.120.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
