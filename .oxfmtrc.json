{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "bun.lock",
    "worker-configuration.d.ts",
    "drizzle/meta",
    "src/routeTree.gen.ts",
    "node_modules",
    "dist",
    ".output",
    ".nitro",
    ".tanstack",
    ".temporal",
    ".wrangler"
  ]
}
