# Temporal worker + HTTP gateway (long-lived Node — not Cloudflare Workers)
# Temporal TS worker needs Node native gRPC; Bun is not used here.
FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Install bun only to respect bun.lock (optional) — use npm install from package.json
COPY package.json bun.lock ./
RUN npm install -g bun \
  && bun install --frozen-lockfile

COPY tsconfig.json ./
COPY src ./src

ENV NODE_ENV=production
ENV TEMPORAL_GATEWAY_PORT=8788
EXPOSE 8788

# tsx runs TypeScript under Node (required for @temporalio/worker)
CMD ["npx", "tsx", "src/temporal/worker.ts"]
